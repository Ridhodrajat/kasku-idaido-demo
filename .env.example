# ===== Supabase (Dashboard > Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SERVER ONLY - jangan diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_service_role_key

# ===== Auth =====
# PIN 6 digit untuk masuk aplikasi (ganti!)
APP_PIN=123456
# String acak panjang (min 32 karakter) untuk menandatangani cookie sesi
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# ===== App =====
NEXT_PUBLIC_APP_NAME=Kasku Idaido
APP_TIMEZONE=Asia/Makassar
